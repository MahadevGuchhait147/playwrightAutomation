{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "Playwright_Automation/Support/Utils/**/*.ts",
    "Playwright_Automation/Support/pageMethod/**/*.ts",
    "Playwright_Automation/Tests/unit/**/*.ts"
  ]
}
