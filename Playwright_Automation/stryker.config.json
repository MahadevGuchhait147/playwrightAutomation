{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "STRYKER=1 npx playwright test --max-failures=1"
  },
  "mutate": ["pages/**/*.ts", "fixtures/**/*.ts", "utils/helpers.ts"],
  "ignorePatterns": ["playwright-report", "test-results", "stryker-report", ".stryker-tmp", "unit"],
  "concurrency": 2,
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "stryker-report/index.html"
  },
  "jsonReporter": {
    "fileName": "stryker-report/mutation.json"
  },
  "coverageAnalysis": "off",
  "timeoutMS": 60000,
  "timeoutFactor": 1.2
}
