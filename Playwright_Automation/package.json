{
  "name": "playwright-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript automation framework.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --config ../vitest.config.mjs",
    "test:unit:watch": "vitest --config ../vitest.config.mjs",
    "test:mutation": "stryker run --configFile ../stryker.conf.json"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@reportportal/agent-js-playwright": "^5.4.1",
    "@types/node": "^25.9.2",
    "dotenv": "^17.4.2",
    "knip": "^6.32.0",
    "prettier": "^3.8.4",
    "typescript": "latest"
  }
}
